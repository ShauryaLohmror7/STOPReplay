# STOPReplay environment configuration template — copy to .env and fill in. NEVER commit .env.

# --- Shared runtime (LLM Provider) ------------------------------------------
# Funded OpenRouter key for the pinned model qwen/qwen-2.5-72b-instruct.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY is also accepted as a fallback for LLM_API_KEY.

# --- STOPReplay database (Supabase / Postgres) ------------------------------
# Hosted Supabase connection string or local throwaway Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stopreplay

# --- revel8 Target API (Simulator) -------------------------------------------
TARGET_API_KEY=
TARGET_API_URL=https://target-api.apps.01.cf.eu01.stackit.cloud/v1

# --- Collection: external web-research services -----------------------------
# Needed ONLY for pre-run OSINT recon.
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
