# STOPReplay Environment Configuration
# Copy this file to .env and fill in your values. .env is gitignored.

# --- revel8 Target API (Simulator) ------------------------------------------
# Team API Key handed out at kickoff for https://target-api.apps.01.cf.eu01.stackit.cloud/v1
REVEL8_TEAM_KEY=
TARGET_API_URL=https://target-api.apps.01.cf.eu01.stackit.cloud/v1

# --- Shared Model Runtime (Qwen 2.5 / OpenRouter) ---------------------------
# Key from https://openrouter.ai/keys (e.g. sk-or-v1-...)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY is also accepted as fallback for LLM_API_KEY.

# --- Database Layer (Cem / Supabase / Postgres) ------------------------------
# Point to local Postgres or Supabase connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stopreplay

# --- Collection Layer (Adrian / OSINT Recon) --------------------------------
# Optional API keys for deep web research
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
