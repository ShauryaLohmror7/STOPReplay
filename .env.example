# STOPReplay database — copy to .env and fill in. NEVER commit .env.
#
# Local throwaway Postgres (recommended for tests; the test suite DROPS the
# public schema, so this must not be a shared or production database):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stopreplay

# Supabase (supplied manually at/after kickoff). Use the connection string from
# Project Settings -> Database. Keep the service-role key server-side only;
# never expose it to any frontend client.

# --- Collection: external web-research services -----------------------------
# Needed ONLY on the machine that runs the pre-run `recon` collection pass
# (e.g. Shaurya's, before the demo). NOT needed by the live simulator runtime,
# which reads already-collected facts from the database. Never commit real keys.
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
